{
    // The repository's TypeScript, which tsc checks and tsgolint lints with
    // type information: the package's source and scripts, the tests, and
    // the configurations of oxfmt and oxlint
    "extends": "@snovader/tsconfig/tsconfig.node.json",
    "compilerOptions": {
        "composite": false,
        "emitDeclarationOnly": false,
        "erasableSyntaxOnly": true,
        "noEmit": true
    },
    "include": [
        "*.config.ts",
        "packages/oxc-config/scripts",
        "packages/oxc-config/source",
        "test"
    ]
}
