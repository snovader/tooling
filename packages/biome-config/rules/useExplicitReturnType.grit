engine biome(1.0)
language js(typescript)

// Requires explicit return types, like Biome's useExplicitReturnType with
// `allowExpressions`, on function declarations, class members, and functions
// bound to variables or to object literal properties. Inline callbacks don't
// need one, and neither do overrides or the members of an object literal that
// takes its type from context, such as a typed variable or the return value of
// a typed function. The built-in rule exempts methods and getters only in
// object literals that are call arguments.

pattern function_without_return_type() {
    or {
        JsArrowFunctionExpression(return_type_annotation=.),
        JsFunctionExpression(return_type_annotation=.)
    }
}

// Arrow functions that the built-in rule skips: `() => value as const` and
// higher-order functions such as `() => (): T => …`
pattern self_typed_function() {
    JsArrowFunctionExpression(body=$body) where {
        $body <: or {
            const_assertion(),
            JsArrowFunctionExpression(),
            JsFunctionExpression()
        }
    }
}

pattern const_assertion() {
    or {
        TsAsExpression(ty=$type) where { $type <: r"const" },
        TsSatisfiesExpression(expression=const_assertion())
    }
}

pattern function_like() {
    or {
        JsFunctionDeclaration(),
        JsFunctionExportDefaultDeclaration(),
        JsFunctionExpression(),
        JsArrowFunctionExpression(),
        JsMethodClassMember(),
        JsMethodObjectMember(),
        JsGetterClassMember(),
        JsGetterObjectMember(),
        JsSetterClassMember(),
        JsSetterObjectMember(),
        JsConstructorClassMember()
    }
}

// Functions whose return values TypeScript checks against a known type
pattern typed_function() {
    or {
        JsFunctionDeclaration(return_type_annotation=TsReturnTypeAnnotation()),
        JsFunctionExportDefaultDeclaration(return_type_annotation=TsReturnTypeAnnotation()),
        JsFunctionExpression(return_type_annotation=TsReturnTypeAnnotation()),
        JsArrowFunctionExpression(return_type_annotation=TsReturnTypeAnnotation()),
        JsMethodClassMember(return_type_annotation=TsReturnTypeAnnotation()),
        JsMethodObjectMember(return_type_annotation=TsReturnTypeAnnotation()),
        JsGetterClassMember(return_type=TsTypeAnnotation()),
        JsGetterObjectMember(return_type=TsTypeAnnotation()),
        or {
            JsMethodObjectMember(),
            JsGetterObjectMember()
        } as $member where { $member <: typed_member() },
        or {
            JsArrowFunctionExpression(),
            JsFunctionExpression()
        } as $function where { $function <: contextually_typed() }
    }
}

// A member of an object literal that has a contextual type
pattern typed_member() {
    $member where {
        $member <: within JsObjectExpression() as $object,
        $object <: contextually_typed()
    }
}

// An expression whose type TypeScript takes from where it appears. Biome's
// GritQL has no parent access, so each case finds an ancestor of the right
// kind and requires the expression to be its child. `within` binds the closest
// matching ancestor, so `$function` below is the function that returns.
pattern contextually_typed() {
    $expression where {
        or {
            $expression <: within JsParenthesizedExpression(expression=$expression) as $parenthesized where {
                $parenthesized <: contextually_typed()
            },
            $expression <: within JsInitializerClause(expression=$expression) as $initializer where {
                $initializer <: within or {
                    JsVariableDeclarator(variable_annotation=TsTypeAnnotation(), initializer=$initializer),
                    JsFormalParameter(type_annotation=TsTypeAnnotation(), initializer=$initializer),
                    JsPropertyClassMember(property_annotation=$annotation, value=$initializer) where {
                        $annotation <: or {
                            TsTypeAnnotation(),
                            TsDefinitePropertyAnnotation(),
                            TsOptionalPropertyAnnotation(type_annotation=TsTypeAnnotation())
                        }
                    }
                }
            },
            $expression <: within TsAsExpression(expression=$expression) as $assertion where {
                not $assertion <: const_assertion()
            },
            $expression <: within TsSatisfiesExpression(expression=$expression),
            $expression <: within TsTypeAssertionExpression(expression=$expression),
            $expression <: within JsCallArguments(args=$arguments) where {
                $arguments <: some $expression
            },
            $expression <: within JsxExpressionAttributeValue(expression=$expression),
            $expression <: within JsPropertyObjectMember(value=$expression) as $property where {
                $property <: typed_member()
            },
            $expression <: within JsArrayExpression(elements=$elements) as $array where {
                $elements <: some $expression,
                $array <: contextually_typed()
            },
            $expression <: within or {
                JsConditionalExpression(consequent=$expression),
                JsConditionalExpression(alternate=$expression)
            } as $conditional where { $conditional <: contextually_typed() },
            $expression <: within JsReturnStatement(argument=$expression) as $return where {
                $return <: within function_like() as $function,
                $function <: typed_function()
            },
            $expression <: within JsArrowFunctionExpression(body=$expression) as $arrow where {
                $arrow <: typed_function()
            }
        }
    }
}

// Plugins also run on JavaScript, which the built-in rule skips. Parentheses in
// a GritQL regex are captures, hence no alternation.
pattern typescript_file() { r".*\.[cm]?tsx?" }

// Each case starts with a node kind, which lets Biome skip all other nodes, and
// matches the file name last. Matching it first made linting the repo 30%
// slower.
or {
    JsFunctionDeclaration(id=$name, return_type_annotation=.) where {
        $filename <: typescript_file(),
        register_diagnostic(span=$name, message="Declare the function's return type.")
    },
    JsFunctionExportDefaultDeclaration(return_type_annotation=.) as $function where {
        $filename <: typescript_file(),
        register_diagnostic(span=$function, message="Declare the function's return type.")
    },
    JsMethodClassMember(name=$name, modifiers=$modifiers, return_type_annotation=.) where {
        not $modifiers <: some TsOverrideModifier(),
        $filename <: typescript_file(),
        register_diagnostic(span=$name, message="Declare the method's return type.")
    },
    JsGetterClassMember(name=$name, modifiers=$modifiers, return_type=.) where {
        not $modifiers <: some TsOverrideModifier(),
        $filename <: typescript_file(),
        register_diagnostic(span=$name, message="Declare the getter's return type.")
    },
    JsPropertyClassMember(name=$name, modifiers=$modifiers, property_annotation=., value=JsInitializerClause(expression=$function)) where {
        $function <: function_without_return_type(),
        not $function <: self_typed_function(),
        not $modifiers <: some TsOverrideModifier(),
        $filename <: typescript_file(),
        register_diagnostic(span=$name, message="Declare the function's return type, or the property's type.")
    },
    JsVariableDeclarator(id=$name, variable_annotation=., initializer=JsInitializerClause(expression=$function)) where {
        $function <: function_without_return_type(),
        not $function <: self_typed_function(),
        $filename <: typescript_file(),
        register_diagnostic(span=$name, message="Declare the function's return type, or the variable's type.")
    },
    JsMethodObjectMember(name=$name, return_type_annotation=.) as $member where {
        not $member <: typed_member(),
        $filename <: typescript_file(),
        register_diagnostic(span=$name, message="Declare the method's return type, or give the object a type.")
    },
    JsGetterObjectMember(name=$name, return_type=.) as $member where {
        not $member <: typed_member(),
        $filename <: typescript_file(),
        register_diagnostic(span=$name, message="Declare the getter's return type, or give the object a type.")
    },
    JsPropertyObjectMember(name=$name, value=$function) as $member where {
        $function <: function_without_return_type(),
        not $function <: self_typed_function(),
        not $member <: typed_member(),
        $filename <: typescript_file(),
        register_diagnostic(span=$name, message="Declare the function's return type, or give the object a type.")
    }
}
