engine biome(1.0)
language js(typescript)

// Enforces the `array-simple` style of typescript-eslint's `array-type` rule,
// which Biome's useConsistentArrayType doesn't offer. Arrays of simple types
// use `T[]` and `readonly T[]`, and all other arrays use `Array<T>` and
// `ReadonlyArray<T>`: `number[][]` and `Buffer[]`, but `Array<Span<Date>>`
// and `Array<[key: string, value: number]>`.

// Keywords, `this` and names without type arguments, or arrays of them
pattern simple_type() {
    or {
        TsAnyType(),
        TsBigintType(),
        TsBooleanType(),
        TsNeverType(),
        TsNonPrimitiveType(),
        TsNullLiteralType(),
        TsNumberType(),
        TsStringType(),
        TsSymbolType(),
        TsThisType(),
        TsUndefinedType(),
        TsUnknownType(),
        TsVoidType(),
        TsReferenceType(type_arguments=.),
        TsArrayType(element_type=simple_type()),
        // Reported on its own, so `Array<number>[]` becomes `number[][]`
        generic_array(name=`Array`, element=simple_type())
    }
}

pattern generic_array($name, $element) {
    TsReferenceType(name=$name, type_arguments=$arguments) where {
        $arguments <: TsTypeArguments(ts_type_argument_list=[$element])
    }
}

// Biome's grammar can't match list nodes or the parent of a node, so these
// find the closest matching ancestor and check that the node is its child.

// `extends` and `implements` name a base interface, which has to stay generic
pattern heritage_type() {
    $type where {
        $type <: within or {
            TsExtendsClause(types=$types),
            TsImplementsClause(types=$types)
        },
        $types <: some $type
    }
}

pattern readonly_operand() {
    $type where {
        $type <: within TsTypeOperatorType(ty=$operand) as $operator,
        $operator <: r"readonly\b[\s\S]*",
        $operand <: $type
    }
}

// `readonly T[]` can't take a postfix `[]` or `[K]` without parentheses
pattern postfix_operand() {
    $type where {
        $type <: within or {
            TsArrayType(element_type=$operand),
            TsIndexedAccessType(object_type=$operand)
        },
        $operand <: $type
    }
}

// Each case starts with a node kind, which lets Biome skip all other nodes.
// Starting with generic_array() made linting the repo four times slower.
or {
    TsReferenceType() as $type where {
        $type <: generic_array(name=`Array`, $element),
        $element <: simple_type(),
        not $type <: heritage_type(),
        register_diagnostic(span=$type, message="Use T[] when the element type is a keyword or a name without type arguments."),
        $type => `$element[]`
    },
    TsReferenceType() as $type where {
        $type <: generic_array(name=`ReadonlyArray`, $element),
        $element <: simple_type(),
        not $type <: heritage_type(),
        // The `T[]` case below makes these `Array<ReadonlyArray<T>>` first
        not $type <: postfix_operand(),
        register_diagnostic(span=$type, message="Use readonly T[] when the element type is a keyword or a name without type arguments."),
        $type => `readonly $element[]`
    },
    TsArrayType(element_type=$element) as $type where {
        not $element <: simple_type(),
        not $type <: readonly_operand(),
        register_diagnostic(span=$type, message="Use Array<T> unless the element type is a keyword or a name without type arguments."),
        $element <: or {
            TsParenthesizedType(ty=$unwrapped),
            $unwrapped
        },
        $type => `Array<$unwrapped>`
    },
    TsTypeOperatorType(ty=TsArrayType(element_type=$element)) as $type where {
        $type <: r"readonly\b[\s\S]*",
        not $element <: simple_type(),
        register_diagnostic(span=$type, message="Use ReadonlyArray<T> unless the element type is a keyword or a name without type arguments."),
        $element <: or {
            TsParenthesizedType(ty=$unwrapped),
            $unwrapped
        },
        $type => `ReadonlyArray<$unwrapped>`
    }
}
