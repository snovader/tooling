{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "assist": {
        "enabled": false
    },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "attributePosition": "auto",
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80,
        "lineEnding": "lf"
    },
    "plugins": [
        {
            "path": "../rules/useArraySimple.grit",
            "resolutionKind": "config"
        },
        {
            "path": "../rules/useExplicitReturnType.grit",
            "resolutionKind": "config"
        }
    ],
    "linter": {
        "rules": {
            "nursery": {
                "noFloatingPromises": "error",
                "noMisusedPromises": "error",
                "useExhaustiveSwitchCases": "error"
            },
            "style": {
                "noInferrableTypes": "error",
                "noNonNullAssertion": "off",
                "noParameterAssign": "error",
                "noUselessElse": "error",
                "useConsistentTypeDefinitions": "error",
                "useDefaultParameterLast": "error",
                "useNumberNamespace": "error",
                "useReadonlyClassProperties": "error",
                "useThrowNewError": "error",
                "useThrowOnlyError": "error"
            },
            "suspicious": {
                "noVar": "error",
                "useArraySortCompare": "error"
            }
        }
    },
    "javascript": {
        "formatter": {
            "arrowParentheses": "asNeeded",
            "bracketSameLine": false,
            "bracketSpacing": true,
            "quoteProperties": "asNeeded",
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "none"
        }
    },
    "overrides": [
        {
            "includes": ["**/*.test.ts", "**/*.test.tsx"],
            "formatter": {
                "lineWidth": 100
            }
        },
        {
            "includes": ["**/tsconfig.json", "**/tsconfig.*.json"],
            "formatter": {
                "lineWidth": 60
            }
        }
    ]
}
