{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "extends": ["./base.json"],
    "linter": {
        "rules": {
            "correctness": {
                "useExhaustiveDependencies": {
                    "level": "error",
                    "options": {
                        "hooks": [
                            {
                                "name": "useComputed",
                                "stableResult": true
                            },
                            {
                                "name": "useSignal",
                                "stableResult": true
                            }
                        ]
                    }
                },
                "useHookAtTopLevel": "error",
                "useJsxKeyInIterable": "error"
            },
            "style": {
                "useSelfClosingElements": "error"
            }
        }
    },
    "javascript": {
        "formatter": {
            "jsxQuoteStyle": "double"
        }
    }
}
