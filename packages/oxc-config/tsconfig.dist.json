{
    // The modules that the package publishes, which tsc compiles to `dist`
    // with their declarations, and which the exports of package.json's
    // publishConfig name
    "extends": "../tsconfig/tsconfig.node.json",
    "compilerOptions": {
        "composite": false,
        "declaration": true,
        "emitDeclarationOnly": false,
        "erasableSyntaxOnly": true,
        "outDir": "dist",
        "rewriteRelativeImportExtensions": true,
        "rootDir": "source"
    },
    "include": ["source"]
}
