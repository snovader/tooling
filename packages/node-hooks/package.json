{
    "name": "@snovader/node-hooks",
    "version": "0.1.0",
    "description": "Synchronous Node.js module hooks: TypeScript stripping with oxc, byte imports, a resolution cache, and Yarn Plug'n'Play resolution.",
    "license": "MIT",
    "type": "module",
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/snovader/tooling.git",
        "directory": "packages/node-hooks"
    },
    "bugs": {
        "url": "https://github.com/snovader/tooling/issues"
    },
    "homepage": "https://github.com/snovader/tooling/tree/main/packages/node-hooks",
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "node",
        "module-hooks",
        "typescript",
        "type-stripping",
        "oxc",
        "yarn-pnp"
    ],
    "engines": {
        "node": ">=26"
    },
    "exports": {
        "./register": "./dist/register.js",
        "./typescript": "./dist/typescript.js",
        "./bytes": "./dist/bytes.js",
        "./cache": "./dist/cache.js",
        "./pnp": "./dist/pnp.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc --project tsconfig.json",
        "prepack": "tsc --project tsconfig.json"
    },
    "dependencies": {
        "oxc-transform": "^0.159.0"
    },
    "peerDependencies": {
        "resolve-pkg-maps": "^1.0.0"
    },
    "peerDependenciesMeta": {
        "resolve-pkg-maps": {
            "optional": true
        }
    },
    "devDependencies": {
        "resolve-pkg-maps": "^1.0.0"
