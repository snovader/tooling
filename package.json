{
  "name": "snovader-tooling",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "yarn format:check && yarn lint:check && yarn typecheck && yarn test",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt",
    "lint:check": "oxlint",
    "lint:write": "oxlint --fix",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@snovader/oxc-config": "workspace:^",
    "@snovader/tsconfig": "workspace:^",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "yarn@4.18.1"
}
