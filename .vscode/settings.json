{
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit"
    },
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "files.eol": "\n",
    "js/ts.experimental.useTsgo": true,
    "js/ts.preferences.importModuleSpecifier": "project-relative",
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,
    "js/ts.tsserver.automaticTypeAcquisition.enabled": false,
    "oxc.path.oxfmt": "node_modules/.bin/oxfmt",
    "oxc.path.oxlint": "node_modules/.bin/oxlint",
    "oxc.path.tsgolint": "node_modules/.bin/tsgolint",
    "search.exclude": {
        "**/.yarn": true,
        "**/dist": true
    },
    "js/ts.tsdk.path": "node_modules/typescript"
}
